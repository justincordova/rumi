{
  "name": "rumi",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.43",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "web": "cd apps/web && bun run dev",
    "server": "cd apps/server && bun run dev",
    "build": "bun run --filter '*' build",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "bun test apps packages"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
