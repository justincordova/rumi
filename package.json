{
  "name": "rumi",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "web": "cd apps/web && bun run dev",
    "server": "cd apps/server && bun run dev",
    "stripe:listen": "mkdir -p apps/server/logs && stripe listen --forward-to localhost:3000/api/billing/webhook 2>&1 | tee apps/server/logs/stripe.log",
    "build": "bun run --filter '*' build",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "bun test apps packages"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/bun": "latest",
    "happy-dom": "^20.9.0",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
